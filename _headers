# Sicherheits-Kopfzeilen fuer die Live-Seite.
# Wird beim Bau nach deploy/_headers kopiert, Cloudflare liest die Datei
# und schickt die Zeilen bei jeder Antwort mit.
#
# Die Richtlinie ist bewusst eng und stuetzt sich auf eine Messung, nicht auf
# eine Vermutung: die Seite laedt aus genau drei Quellen: sich selbst, dem
# Worker und dem Eversports-Gutschein-Widget auf /gutscheine/ (loader.js von
# widget-static.eversports.io, GraphQL-API und Bilder von files.eversports.com;
# der Checkout oeffnet www.eversports.de in einem neuen Tab). Gemessen am
# 10.09.2026: ohne diese Freigaben blieb das Widget unsichtbar, 0 px hoch.
#
# ACHTUNG, wenn spaeter GA4 oder der Meta-Pixel dazukommen: dann muessen
# script-src, connect-src und img-src um die Google- und Meta-Adressen
# erweitert werden, sonst laedt die Messung nicht und niemand merkt es,
# weil eine blockierte Zeile nur in der Browser-Konsole steht.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
  # 10.09.2026: Cloudflares eigene Besucherzaehlung (Web Analytics) laedt
  # beacon.min.js von static.cloudflareinsights.com und meldet an
  # cloudflareinsights.com. Ohne diese beiden Eintraege blockt die
  # Richtlinie die Zaehlung STILL, sobald der Schalter im Dashboard
  # umgelegt wird. Cloudflare liefert ohnehin jedes Byte dieser Seite
  # aus, die Freigabe vergroessert die Angriffsflaeche also nicht.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://widget-static.eversports.io https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://files.eversports.com https://widget-static.eversports.io; media-src 'self' blob:; font-src 'self' data: https://widget-static.eversports.io; connect-src 'self' data: https://cloudflareinsights.com https://dds-frag.s-kellerberlin.workers.dev https://graphql-widget-master.production.eversports.cloud https://widget-static.eversports.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://www.eversports.de; object-src 'none'; upgrade-insecure-requests
  # includeSubDomains ergaenzt 10.09.2026. Geprueft wurden alle vier
  # Subdomains: www, events und 360 antworten sauber ueber HTTPS,
  # autodiscover leitet http ohnehin schon auf https um. Es geht also
  # nichts kaputt, was nicht vorher schon so war.
  # preload absichtlich NICHT: die Aufnahme in die Browserliste laesst
  # sich monatelang nicht rueckgaengig machen, das entscheidet Sebastian.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Medien aendern sich nur mit ihrem Namen (Inhalts-Fingerabdruck bei Bildern,
# fester Name bei den Clips). Ein Jahr Cache spart bei jedem zweiten Besuch
# die kompletten 3,5 MB.
/medien/*
  Cache-Control: public, max-age=31536000, immutable

# Die Pruefliste ist ein internes Werkzeug und geht niemanden sonst etwas an.
/check/*
  X-Robots-Tag: noindex, nofollow

# Icons und Manifest aendern sich selten, ein Tag Cache reicht.
/favicon.ico
  Cache-Control: public, max-age=86400
/icon-*.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400

